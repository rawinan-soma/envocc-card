        "focus": [
          "spa",
          "guard",
          "api",
          "db"
        ],
        "note": "Applicants and admins call the API with JWT cookies; the strategy re-reads the row from Postgres on every request."
      },
      {
        "id": "qr-verify",
        "label": "Public QR verification",
        "focus": [
          "verifier",
          "api",
          "redis",
          "worker",
          "db"
        ],
        "note": "Unguarded common/qrcode routes mint a short-lived token; a delayed cleanup job nulls it after 5 minutes."
      },
      {
        "id": "password-reset",
        "label": "Password reset email",
        "focus": [
          "spa",
          "api",
          "redis",
          "worker",
          "gmail"
        ],
        "note": "Reset requests enqueue an email job; the processor sends a Thai HTML email via Gmail SMTP."
      }
