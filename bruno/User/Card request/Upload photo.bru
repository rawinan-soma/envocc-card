meta {
  name: Upload photo
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/users/me/photo
  body: multipartForm
  auth: none
}

body:multipart-form {
  photo: @file()
}

docs {
  User login (cookie Authentication_User): run "User auth / Login" first. The user must also be approved (is_validate), or this answers 403. A JPG or PNG of at most 10 MB.
}
