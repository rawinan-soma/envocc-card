meta {
  name: My file
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/users/me/files/:file
  body: none
  auth: none
}

params:path {
  file: photo
}

docs {
  User login (cookie Authentication_User): run "User auth / Login" first. The user must also be approved (is_validate), or this answers 403. `:file` is one of `envcard`, `expfile`, `govcard`, `photo`, `reqFile`.
}
