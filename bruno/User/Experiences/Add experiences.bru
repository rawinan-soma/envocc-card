meta {
  name: Add experiences
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/users/me/experiences
  body: json
  auth: none
}

body:json {
  [
    {
      "exp_fdate": "2020-01-01",
      "exp_ldate": "2023-12-31",
      "exp_typeoffice": 1,
      "exp_office": "โรงพยาบาลตัวอย่าง",
      "exp_position": "นักวิชาการสาธารณสุข",
      "exp_work": "งานอาชีวอนามัย"
    }
  ]
}

docs {
  User login (cookie Authentication_User): run "User auth / Login" first. An array of experiences, all added to the logged-in user (a `userId` in an item is ignored). Only at request status 0, 1 or 6; at any other status, or with no status history, 403 "personal data can be edited only at request status 0, 1 or 6" and nothing changes.
}
