meta {
  name: Edit experience
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/users/me/experiences/:expId
  body: json
  auth: none
}

params:path {
  expId: 1
}

body:json {
  {
    "exp_work": "งานอาชีวอนามัยและสิ่งแวดล้อม"
  }
}

docs {
  User login (cookie Authentication_User): run "User auth / Login" first. Any experience field. Only the user's own experience; otherwise 404 "experience not found". Only at request status 0, 1 or 6; at any other status, or with no status history, 403 "personal data can be edited only at request status 0, 1 or 6" and nothing changes.
}
