meta {
  name: Delete experience
  type: http
  seq: 4
}

delete {
  url: {{baseUrl}}/users/me/experiences/:expId
  body: none
  auth: none
}

params:path {
  expId: 1
}

docs {
  User login (cookie Authentication_User): run "User auth / Login" first. Only the user's own experience; otherwise 404 "experience not found". Only at request status 0, 1 or 6; at any other status, or with no status history, 403 "personal data can be edited only at request status 0, 1 or 6" and nothing changes.
}
