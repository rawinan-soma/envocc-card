meta {
  name: Set QR password
  type: http
  seq: 2
}

patch {
  url: {{baseUrl}}/users/me/members/qrcode
  body: json
  auth: none
}

body:json {
  {
    "password": "<qr password>"
  }
}

docs {
  User login (cookie Authentication_User): run "User auth / Login" first. The user must also be approved (is_validate), or this answers 403.
}
