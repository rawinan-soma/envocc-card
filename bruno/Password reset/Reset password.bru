meta {
  name: Reset password
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/reset-password
  body: json
  auth: none
}

body:json {
  {
    "token": "<token from the reset email>",
    "newPass": "<new password>"
  }
}

docs {
  No login. The token comes from the email sent by "Request password reset" (admin or user).
}
