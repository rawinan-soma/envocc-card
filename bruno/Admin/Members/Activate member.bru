meta {
  name: Activate member
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/admins/members/:userId/activate
  body: json
  auth: none
}

params:path {
  userId: 1
}

body:json {
  {
    "startDate": "2026-10-15"
  }
}

docs {
  Admin login (cookie Authentication_Admin): run "Admin auth / Login" first. Sets the approval date (`startDate`) of a user at request status 8 or 11: the card is valid from it for 5 years. Moves the user on to 9 or 12. The card itself becomes valid only when the request reaches 15.
}
