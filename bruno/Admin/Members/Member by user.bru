meta {
  name: Member by user
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/admins/members/:userId
  body: none
  auth: none
}

params:path {
  userId: 1
}

docs {
  Admin login (cookie Authentication_Admin): run "Admin auth / Login" first. Returns the user's latest card, valid or not (`is_active`), such as the card being issued and printed.
}
