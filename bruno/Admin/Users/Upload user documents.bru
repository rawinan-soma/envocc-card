meta {
  name: Upload user documents
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/admins/users/:userId/files
  body: multipartForm
  auth: none
}

params:path {
  userId: 1
}

body:multipart-form {
  requestFile: @file()
  govCard: @file()
  experienceForm: @file()
}

docs {
  Admin login (cookie Authentication_Admin): run "Admin auth / Login" first. Uploads PDFs (10 MB each) for the user in the `:userId` path parameter, at any request status, and moves them to 4. `govCard` is required unless the user already has one; `requestFile` and `experienceForm` are optional.
}
